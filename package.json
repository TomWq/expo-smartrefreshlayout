{
  "name": "expo-smartrefreshlayout",
  "version": "2.0.0-alpha.0",
  "description": "A React Native Fabric pull-to-refresh and load-more component backed by SmartRefreshLayout and SmartRefreshControl",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "import": "./lib/module/index.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "android/build.gradle",
    "android/src",
    "ios",
    "src",
    "docs",
    "lib",
    "ExpoSmartrefreshlayout.podspec",
    "react-native.config.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib build android/build ios/build generated",
    "codegen": "node node_modules/react-native/scripts/generate-codegen-artifacts.js -p . -t all -s library -o generated",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --watchman=false",
    "prepare": "bob build",
    "prepack": "npm run typecheck",
    "pack:dry-run": "npm pack --dry-run",
    "npm:login": "npm login --auth-type=web --registry=https://registry.npmjs.org/",
    "release:guard": "node scripts/release-guard.js",
    "release:check": "npm run release:guard && npm run typecheck && npm test && npm run build && npm run pack:dry-run && npm run release:guard",
    "preversion": "npm run release:guard",
    "publish:dry-run": "node scripts/publish-dry-run.js",
    "publish:npm": "npm publish --access public --registry=https://registry.npmjs.org/",
    "publish:alpha": "npm publish --tag alpha --access public --registry=https://registry.npmjs.org/",
    "release:patch": "npm run release:check && node scripts/release-version.js patch && npm run publish:npm",
    "release:minor": "npm run release:check && node scripts/release-version.js minor && npm run publish:npm",
    "release:major": "npm run release:check && node scripts/release-version.js major && npm run publish:npm",
    "release:alpha": "npm run release:check && npm version prerelease --preid=alpha && npm run publish:alpha"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "codegenConfig": {
    "name": "ExpoSmartRefreshLayoutSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.exposmartrefreshlayout"
    },
    "ios": {
      "componentProvider": {
        "ExpoSmartRefreshLayoutView": "ExpoSmartRefreshLayoutView",
        "ExpoSmartRefreshHeaderSlot": "ExpoSmartRefreshHeaderSlotView"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "keywords": [
    "react-native",
    "fabric",
    "new-architecture",
    "refresh",
    "pull-to-refresh",
    "load-more",
    "smartrefreshlayout",
    "mjrefresh",
    "android",
    "ios"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomWq/expo-smartrefreshlayout.git"
  },
  "bugs": {
    "url": "https://github.com/TomWq/expo-smartrefreshlayout/issues"
  },
  "author": "TomWq <582752848@qq.com> (https://github.com/TomWq)",
  "license": "MIT",
  "homepage": "https://github.com/TomWq/expo-smartrefreshlayout#readme",
  "devDependencies": {
    "@react-native/babel-preset": "^0.81.5",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.43.0",
    "react-test-renderer": "^19.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.76.0"
  },
  "engines": {
    "node": ">=18"
  }
}
